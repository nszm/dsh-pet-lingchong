{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "paths": {
      "react": ["../dev/node_modules/@types/react"],
      "react/jsx-runtime": ["../dev/node_modules/@types/react/jsx-runtime"]
    },
    "types": []
  },
  "include": ["src"]
}
